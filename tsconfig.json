{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "vite/client"
    ],
    "paths": {
      "react": [
        "./node_modules/@types/react"
      ],
      "react/*": [
        "./node_modules/@types/react/*"
      ]
    }
  },
  "include": [
    "packages/*/src",
    "packages/*/tests",
    "packages/*/components",
    "packages/ui/vite.config.ts",
    "docs/fdbook.config.ts",
    "eslint.config.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "packages/diagram/src/note-text.ts"
  ]
}
